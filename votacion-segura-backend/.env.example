# ============================================================
# Sistema de Votación Segura — Variables de Entorno
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo como .env en la raíz del proyecto.
#   2. Reemplaza TODOS los valores PLACEHOLDER con valores reales.
#   3. NUNCA commitees el archivo .env al repositorio.
#   4. El archivo .env está en .gitignore.
#
# Para generación segura de contraseñas:
#   openssl rand -base64 32
#
# Para generación del JWT secret (mínimo 256 bits):
#   openssl rand -base64 64
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
# Superusuario de PostgreSQL (solo para inicialización del contenedor)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PLACEHOLDER_SUPERUSER_PASSWORD
POSTGRES_DB=votacion_segura_db

# Usuario de migraciones (Flyway) — propietario de tablas
DB_MIGRA_USER=votacion_migra
DB_MIGRA_PASSWORD=PLACEHOLDER_MIGRA_PASSWORD

# Usuario de la aplicación (runtime) — permisos mínimos
DB_APP_USER=votacion_app
DB_APP_PASSWORD=PLACEHOLDER_APP_PASSWORD

# Host y puerto de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=votacion_segura_db

# ── JWT ───────────────────────────────────────────────────────
# Secret para firmar JWT. Mínimo 256 bits (32 bytes en base64).
# Generar con: openssl rand -base64 64
JWT_SECRET=PLACEHOLDER_JWT_SECRET_MIN_256_BITS

# Duración del access token en milisegundos (default: 15 minutos)
JWT_ACCESS_EXPIRATION_MS=900000

# Duración del refresh token en milisegundos (default: 8 horas = jornada electoral)
JWT_REFRESH_EXPIRATION_MS=28800000

# ── Credenciales de voto ─────────────────────────────────────
# Duración de la credencial de voto en minutos (default: 30)
CREDENCIAL_EXPIRACION_MINUTOS=30

# ── OTP ──────────────────────────────────────────────────────
# Duración del OTP en minutos (default: 10)
OTP_EXPIRACION_MINUTOS=10

# Máximo de intentos OTP antes de invalidar (default: 5)
OTP_MAX_INTENTOS=5

# ── Seguridad ─────────────────────────────────────────────────
# Máximo de intentos de login antes de bloquear cuenta (default: 5)
SECURITY_MAX_INTENTOS_LOGIN=5

# Tiempo de bloqueo de cuenta en minutos (default: 15)
SECURITY_BLOQUEO_MINUTOS=15

# ── CORS ─────────────────────────────────────────────────────
# Origen permitido para el frontend React
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ── Correo (OTP) ──────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=PLACEHOLDER_MAIL_USER
MAIL_PASSWORD=PLACEHOLDER_MAIL_PASSWORD
MAIL_FROM=noreply@votacion.espe.ec

# ── Actuator ─────────────────────────────────────────────────
# Contraseña para endpoints de Actuator
ACTUATOR_USERNAME=actuator
ACTUATOR_PASSWORD=PLACEHOLDER_ACTUATOR_PASSWORD

# ── Perfil de Spring ─────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
